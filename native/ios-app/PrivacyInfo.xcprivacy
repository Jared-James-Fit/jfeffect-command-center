<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  JF Effect's app privacy manifest (the App target). Copied into ios/App/App and
  added to the target's Resources by .github/workflows/ios-build.yml on every
  build ("cap add ios" regenerates the project, so it can't live under ios/).
  Capacitor and the JfPhotos pod ship their own manifests for their own code.

  Collected data: what the app (the jfeffect.com web app inside it) actually
  collects, all linked to the account, none used for tracking; it must match
  the App Privacy answers in App Store Connect (docs/APP_STORE_LISTING.md).
  Required-reason APIs: the app target itself only reads its own UserDefaults
  (CA92.1). Review both lists whenever a native plugin or a data type is added.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
